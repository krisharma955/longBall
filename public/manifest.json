{
  "manifest_version": 3,
  "name": "longBall - Live Football Companion",
  "version": "1.0.0",
  "description": "Next-gen football sidebar companion with live scores, match stats, lineups, and fixtures.",
  "action": {
    "default_title": "Open longBall Sidebar",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel"
  ],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
